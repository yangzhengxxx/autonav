<?xml version="1.0"?>
<package format="2">
  <name>can1_pkg</name>
  <version>0.1.0</version>
  <description>
    基于 SocketCAN 的 CAN1 底盘反馈接收与里程计积分节点。
    CAN1 里程计接收（0x011）与速度下发（0x010 /cmd_vel），供 slam_toolbox / AMCL / move_base 使用。
  </description>

  <maintainer email="yangzhengxxx@users.noreply.github.com">yangzhengxxx</maintainer>
  <license>MIT</license>

  <buildtool_depend>catkin</buildtool_depend>

  <depend>roscpp</depend>
  <depend>nav_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>

  <exec_depend>slam_toolbox</exec_depend>
  <exec_depend>amcl</exec_depend>
  <exec_depend>map_server</exec_depend>
  <exec_depend>move_base</exec_depend>
  <exec_depend>dwa_local_planner</exec_depend>
  <exec_depend>navfn</exec_depend>
  <exec_depend>rospy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>

  <export>
  </export>
</package>
